# ====================================
# CONFIGURATION DE L'APPLICATION
# ====================================

# Environnement (development, production, test)
NODE_ENV=development

# URL de l'application (sans / à la fin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with:openssl rand -base64 32

# ====================================
# BASE DE DONNÉES
# ====================================

# PostgreSQL (format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA)
DATABASE_URL=postgresql://user:password@localhost:5432/yourdbname?schema=public

# Configuration de la connexion directe (optionnel pour certaines fonctionnalités)
POSTGRES_URL=postgresql://user:password@localhost:5432/yourdbname
POSTGRES_PRISMA_URL=postgresql://user:password@localhost:5432/yourdbname?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://user:password@localhost:5432/yourdbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=yourdbname

# ====================================
# AUTHENTIFICATION (Clerk)
# ====================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_*
CLERK_SECRET_KEY=sk_test_*
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ====================================
# CONFIGURATION VERCEL (automatique)
# ====================================

VERCEL_URL=
VERCEL_ENV=development
VERCEL_GIT_PROVIDER=
VERCEL_GIT_REPO_SLUG=
VERCEL_GIT_REPO_OWNER=
VERCEL_GIT_REPO_ID=
VERCEL_GIT_COMMIT_REF=
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_MESSAGE=
VERCEL_GIT_COMMIT_AUTHOR_LOGIN=
VERCEL_GIT_COMMIT_AUTHOR_NAME=

# ====================================
# OPTIMISATION ET SURVEILLANCE
# ====================================

# Activer les logs détaillés (true/false)
NEXT_PUBLIC_DEBUG=false

# Désactiver la télémétrie Next.js
NEXT_TELEMETRY_DISABLED=1

# Configuration du cache (en secondes)
CACHE_TTL=3600

# ====================================
# SÉCURITÉ
# ====================================

# Clé secrète pour les tokens JWT (générer une nouvelle avec: openssl rand -base64 32)
JWT_SECRET=generate_with:openssl rand -base64 32

# Protection CSRF (Cross-Site Request Forgery)
CSRF_SECRET=generate_with:openssl rand -base64 32

# Configuration CORS (séparer les origines par des virgules)
NEXT_PUBLIC_CORS_ORIGINS=http://localhost:3000,https://votredomaine.com

# ====================================
# SERVICES TIERS (optionnels)
# ====================================

# Email (ex: SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com

# Stockage (ex: AWS S3, Cloudflare R2, etc.)
# STORAGE_PROVIDER=local # local, s3, r2, etc.
# S3_BUCKET_NAME=your-bucket
# S3_REGION=your-region
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT= # Optionnel pour certains fournisseurs

# Analytics (ex: Google Analytics, PostHog, etc.)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ====================================
# FONCTIONNALITÉS AVANCÉES
# ====================================

# Activer/désactiver les fonctionnalités expérimentales
FEATURE_FLAG_EXPERIMENTAL=false

# Limite de taux (rate limiting)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # 100 requêtes par fenêtre

# Configuration du cache côté serveur
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 heure en secondes

# ====================================
# JOURNALISATION (LOGGING)
# ====================================

# Niveau de log (error, warn, info, debug, trace)
LOG_LEVEL=info

# Format des logs (json, pretty, hidden)
LOG_FORMAT=pretty

# Journalisation des requêtes HTTP
LOG_HTTP_REQUESTS=true

# ====================================
# MAINTENANCE ET DÉBOGAGE
# ====================================

# Mode maintenance (true/false)
MAINTENANCE_MODE=false

# Message de maintenance personnalisé
MAINTENANCE_MESSAGE=Notre application est en cours de maintenance. Veuillez réessayer plus tard.

# Activer le mode débogage (ne pas activer en production)
DEBUG=false

# ====================================
# CONFIGURATION DU DÉPLOIEMENT
# ====================================

# Délai maximal d'exécution des fonctions (en secondes)
FUNCTION_TIMEOUT=10

# Taille maximale du corps de la requête (en Mo)
NEXT_PUBLIC_MAX_BODY_SIZE=10

# Activer la compression (gzip/brotli)
COMPRESSION_ENABLED=true

# ====================================
# CONFIGURATION DU CACHE NAVIGATEUR
# ====================================

# Durée de mise en cache des actifs statiques (en secondes)
BROWSER_CACHE_TTL=31536000  # 1 an

# ====================================
# CONFIGURATION DU RENDU CÔTÉ SERVEUR (SSR)
# ====================================

# Activer le rendu côté serveur (true/false)
NEXT_PUBLIC_SSR_ENABLED=true

# Délai d'attente pour le rendu côté serveur (en millisecondes)
SSR_TIMEOUT=10000

# ====================================
# CONFIGURATION DES NOTIFICATIONS
# ====================================

# Activer les notifications (true/false)
NOTIFICATIONS_ENABLED=true

# URL du service de notifications
# NOTIFICATIONS_SERVICE_URL=https://api.example.com/notifications

# Clé API pour le service de notifications
# NOTIFICATIONS_API_KEY=your-notifications-api-key
